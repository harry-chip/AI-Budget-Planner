    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"currency\":{\"type\":\"string\"},\"monthly_income\":{\"type\":\"number\"},\"total_expenses\":{\"type\":\"number\"},\"remaining_balance\":{\"type\":\"number\"},\"savings_rate_percent\":{\"type\":\"number\"},\"savings_goal\":{\"type\":\"number\"},\"savings_goal_difference\":{\"type\":\"number\"},\"spending_analysis\":{\"type\":\"string\"},\"savings_recommendations\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"recommended_budget\":{\"type\":\"object\",\"properties\":{\"housing\":{\"type\":\"number\"},\"food\":{\"type\":\"number\"},\"transport\":{\"type\":\"number\"},\"bills_utilities\":{\"type\":\"number\"},\"other\":{\"type\":\"number\"},\"savings\":{\"type\":\"number\"}}}},\"required\":[\"total_expenses\",\"remaining_balance\",\"savings_rate_percent\",\"spending_analysis\",\"savings_recommendations\",\"recommended_budget\"]}"
      },
